    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.0.0",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.29",

# ── Database ────────────────────────────────────────────────────────
# Local dev (SQLite, zero setup). Works out of the box.
#DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.rugsunlzarccaojyvwcx.supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.rugsunlzarccaojyvwcx.supabase.co:5432/postgres"
# To switch to PostgreSQL later (Docker / Neon / Supabase / local install):
#   1. Replace the line above with e.g.
#      DATABASE_URL="postgresql://user:password@localhost:5432/nearwheels?schema=public"
#   2. Run: npx prisma db push && npm run db:seed
# The schema is written to be valid on both dialects.

# ── AI bot (Google Gemini) ─────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ── Google Auth (https://console.cloud.google.com/apis/credentials) ─────
# Create OAuth 2.0 Client ID (Web application) and set authorized origin to your site URL
GOOGLE_CLIENT_ID=""
# Optional: also set NEXT_PUBLIC_GOOGLE_CLIENT_ID for client-side GIS (same value)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── Security ────────────────────────────────────────────────────────
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seed admin login for /admin (change after first run)
ADMIN_PHONE="9000000001"
ADMIN_PASSWORD="admin@nearwheels"

# Demo customer phone used by seed data
DEMO_CUSTOMER_PHONE="9000000002"

# ── Razorpay (single admin merchant — ALL bookings) ──────────────────
# WHERE ADMIN PUTS CREDENTIALS: this file (.env at project root, same folder as package.json).
# 1. Create Razorpay account at https://razorpay.com → Dashboard → Settings → API Keys → Generate Key
# 2. Copy Key ID + Key Secret here (keep secret private, never commit .env)
# 3. Webhook Secret: Dashboard → Settings → Webhooks → Add Webhook → URL = https://yourdomain.com/api/payments/razorpay/webhook → Secret → paste here
# 4. For client checkout (UPI/Card), also set NEXT_PUBLIC_RAZORPAY_KEY_ID (same as RAZORPAY_KEY_ID)
# NO provider accounts needed — single admin Razorpay account collects UPI/Card/Netbanking/Wallet for every booking (vehicles, yatra, driving, farm, etc.)
# Admin pays providers directly from his own bank/UPI after deducting 10% platform fee, or customer pays remaining 80% after ride completion via same admin Razorpay.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
PAYMENT_WEBHOOK_SECRET=""
# Optional: also set NEXT_PUBLIC_RAZORPAY_KEYID as alias (code reads both)
# NEXT_PUBLIC_RAZORPAY_KEYID=""

# Legacy: Payment gateway mode. Leave as "razorpay" when live, "simulated" falls back if Razorpay creds missing.
PAYMENT_MODE="razorpay"
